#pragma once

// Copy this file to config.h. config.h is deliberately ignored by Git.
#define WIFI_SSID "YOUR_2_4_GHZ_WIFI"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Automatic fallback configuration hotspot after 2 minutes without Wi-Fi.
// Connect to this 2.4 GHz AP and open http://192.168.4.1 to store another Wi-Fi.
#define TFT_SETUP_AP_SSID "Litvinov-TFT-Setup"
#define TFT_SETUP_AP_PASSWORD "litvinov"
#define TFT_API_BASE_URL "http://192.168.0.10:8080"

// LAN OTA only. Use a unique password of at least 12 characters in real config.h.
// Never publish this value and never expose ESP OTA ports to the Internet.
#define OTA_HOSTNAME "litvinov-tft"
#define OTA_PASSWORD "CHANGE_ME_TO_A_LONG_UNIQUE_OTA_PASSWORD"

// Proposed shared SPI wiring for ILI9341 + XPT2046 touch.
// Confirm the labels on the back of the physical TFT before connecting.
// Do not connect 5 V logic directly to ESP32-S3 GPIO.
#define TFT_SCK_PIN 12       // SCK + T_CLK
#define TFT_MOSI_PIN 11      // MOSI/SDI + T_DIN
#define TFT_MISO_PIN 13      // MISO/SDO + T_DO
#define TFT_CS_PIN 10        // TFT CS
#define TFT_DC_PIN 9         // TFT DC / RS / A0
#define TFT_RST_PIN 14       // TFT RST
#define TFT_BACKLIGHT_PIN 21 // TFT LED / BL, active HIGH
#define TOUCH_CS_PIN 8       // XPT2046 T_CS
#define TOUCH_IRQ_PIN 18     // XPT2046 T_IRQ (not used by this display-only test)
